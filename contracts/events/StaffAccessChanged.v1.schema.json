{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commerce:identity:StaffAccessChanged:1",
  "title": "StaffAccessChanged v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAtUtc",
    "producer",
    "aggregateId",
    "aggregateVersion",
    "correlationId",
    "causationId",
    "traceParent",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "StaffAccessChanged"
    },
    "version": {
      "const": 1
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "commerce.identity"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": "string",
      "minLength": 1
    },
    "traceParent": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "access"
      ],
      "additionalProperties": false,
      "properties": {
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userId",
            "branches"
          ],
          "properties": {
            "userId": {
              "type": "string",
              "format": "uuid"
            },
            "branches": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "branchId",
                  "permissions"
                ],
                "properties": {
                  "branchId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "permissions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
