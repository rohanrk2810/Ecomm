{
  "ReverseProxy": {
    "Routes": {
      "customer-registration": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/registrations", "Methods": ["POST"] }
      },
      "registration-policy": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/identity/registration-policy", "Methods": ["GET"] }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "one": { "Address": "http://localhost:5082" } },
        "HttpRequest": { "ActivityTimeout": "00:00:20" }
      }
    }
  }
}
