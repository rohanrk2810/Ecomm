{
  "ReverseProxy": {
    "Routes": {
      "email-verification": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/identity/email-verifications",
          "Methods": [
            "POST"
          ]
        }
      },
      "verification-resend": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/identity/email-verification-requests",
          "Methods": [
            "POST"
          ]
        }
      },
      "customer-registration": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/identity/registrations",
          "Methods": [
            "POST"
          ]
        }
      },
      "registration-policy": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/identity/registration-policy",
          "Methods": [
            "GET"
          ]
        }
      },
      "password-reset-requests": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/identity/password-reset-requests",
          "Methods": [
            "POST"
          ]
        }
      },
      "password-resets": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/identity/password-resets",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "one": {
            "Address": "http://localhost:5082"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:20"
        }
      }
    }
  }
}
