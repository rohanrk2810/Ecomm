@model OpenIddict.Abstractions.OpenIddictRequest
@{ Layout=null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign out</title><link rel="stylesheet" href="/identity.css"></head>
<body><main><h1>Finish signing out.</h1><p>Confirm to close your sign-in session.</p>
<form method="post" action="/connect/logout">@Html.AntiForgeryToken()
<input type="hidden" name="client_id" value="@Model.ClientId"><input type="hidden" name="id_token_hint" value="@Model.IdTokenHint">
<input type="hidden" name="post_logout_redirect_uri" value="@Model.PostLogoutRedirectUri"><input type="hidden" name="state" value="@Model.State">
<button type="submit">Confirm sign out</button></form></main></body></html>
