{
  "AllowedHosts": "localhost;127.0.0.1;identity",
  "Registration": {
    "MinimumPasswordLength": 12,
    "MaximumPasswordLength": 128,
    "RequireDigit": true,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireNonAlphanumeric": true,
    "RequestsPerMinute": 20
  },
  "Messaging": { "PollIntervalMilliseconds": 1000 },
  "Logging": { "LogLevel": { "Default": "Warning", "Commerce.Identity": "Information" } }
}
